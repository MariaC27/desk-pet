{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk Pet",
  "version": "1.0.0",
  "identifier": "com.deskpet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "Desk Pet",
        "width": 120,
        "height": 132,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Lifestyle",
    "shortDescription": "A little plant that grows with your GitHub contributions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Desk Pet Signing"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5RjM1NkVCMjlFRjk5RjgKUldUNG1lOHA2MWJ6Nld1VFFiQnBJbDFMLzJheFFVeUc2dHA5dXFtMmFYQ25ka2NJc0g0QzAvaG8K",
      "endpoints": [
        "https://github.com/MariaC27/desk-pet/releases/latest/download/latest.json"
      ]
    }
  }
}
